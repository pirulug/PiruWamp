# Compilados y artefactos de Python
build/
dist/
.build/
_build/
.compile/
__pycache__/
*.py[cod]
*$py.class
*.spec

# Ejecutables
piruwamp.exe

# Logs de la aplicación
*.log
crash.log

# Datos de la base de datos (MariaDB)
# Ignorar todo en data/ excepto si hay un .gitignore ahí
data/*
!data/.gitignore

# Proyectos del usuario
# Ignorar todos los proyectos creados, excepto el index.php
www/*
!www/index.php
!www/.gitignore

__init__.py
